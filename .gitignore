node_modules/
dist/
out/
coverage/
# Packaged installers (electron-builder output) — build artifacts, never source.
# release-archive/ holds superseded installers kept for rollback; they are the same
# ~100 MB binaries and must stay out of git just as firmly (GitHub refuses files
# over 100 MB, and a committed one cannot be removed from history cheaply).
release/
release-archive/
*.log
.DS_Store
.vscode/settings.json

# --- Signing credentials and secrets must NEVER be committed -----------------
# Code-signing keys live on a hardware token or cloud HSM and are supplied to the
# build through environment variables (see docs/25-code-signing.md). These patterns
# are a second line of defence in case a certificate, key or env file is ever
# written into the repository by mistake.
.env
.env.*
!.env.example
*.pfx
*.p12
*.pem
*.key
*.cer
*.crt
*.spc
*.pvk

# Local runtime data (the app keeps its database in the per-user app-data folder;
# this repo-local folder is a legacy location that is only read, never written)
apps/desktop/.runtime/

# Debug / scratch files must never be committed at the root
tmp-*.sqlite*
*.sqlite-shm
*.sqlite-wal
.tmp-*

# --- ERP business data must NEVER be committed -------------------------------
# The live database and everything derived from it belongs in the per-user
# app-data folder (%LOCALAPPDATA%/777-erp), never in source control. Git cannot
# merge a binary SQLite file, and committing one while the app is running would
# capture a torn snapshot because the database runs in WAL mode. These patterns
# are a second line of defence in case a database, backup or export is ever
# created inside the repository by mistake.
*.sqlite
*.sqlite3
*.db
*-journal
backups/
logs/
product-images/
delivery-proofs/
session.bin
data-migration.json

# --- Local reference material ------------------------------------------------
# Photographs and scans kept beside the code for reference while building a
# screen. They are not source, and an untracked one here is enough to make
# scripts/write-build-info.mjs --strict refuse a release: it fails on ANY
# `git status --porcelain` output, deliberately, so a build can always be tied
# to a commit. Ignoring the folder keeps that gate meaningful without asking
# anyone to move their reference pictures somewhere else first.
REFERENCE PICS/

# --- Local agent and MCP tooling -------------------------------------------
# Per-machine, not project source. .claude/settings.local.json records which MCP
# servers this machine has enabled and its permission allow-list; .mcp.json pins
# the Supabase project ref. Both are configuration for whoever is sitting here,
# and committing them would push one developer's tool setup onto everyone else.
.claude/
.mcp.json
.agents/
.kiro/
skills-lock.json
